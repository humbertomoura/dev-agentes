{
  "verificar-diff-apos-edicao": {
    "enabled": false,
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "git diff --check",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
